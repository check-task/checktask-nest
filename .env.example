# 이 파일을 .env로 복사해 값을 채웁니다.
# (필수) 표시가 있는 값이 없거나 비어 있으면 서버가 뜨지 않습니다. (src/common/config/env.validation.ts)
# 변수 설명은 docs/COMMON.md "환경 변수"를 참고합니다.

# ===== 서버 =====
NODE_ENV=development              # development | production | test
PORT=8000

# ===== database (PostgreSQL) =====
DB_HOST=localhost                 # (필수)
DB_PORT=5432
DB_USERNAME=                      # (필수)
DB_PASSWORD=                      # (필수)
DB_DATABASE=Check_Task_DB         # (필수)
# 운영(NODE_ENV=production)만 SSL로 접속합니다. RDS 인증서 번들(global-bundle.pem) 경로를 주면 인증서까지 검증합니다.
DB_SSL_CA=

# ===== redis =====
REDIS_HOST=localhost              # (필수)
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== s3 =====
AWS_REGION=ap-northeast-2         # (필수)
AWS_S3_BUCKET=checktask           # (필수)
# 키를 비우면 SDK 기본 자격 증명(EC2 IAM Role 등)을 씁니다.
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=

# ===== auth (JWT) =====
JWT_SECRET=                       # (필수) Access Token 서명 키
# auth 도메인 구현 시 사용합니다. (Refresh Token은 JWT_REFRESH_SECRET으로 서명)
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ===== fcm (푸시) — Firebase 콘솔 > 프로젝트 설정 > 서비스 계정에서 발급한 키의 값 =====
FIREBASE_PROJECT_ID=              # (필수)
FIREBASE_CLIENT_EMAIL=            # (필수)
# (필수) 줄바꿈은 \n으로 적고 전체를 따옴표로 감쌉니다.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===== mail (Gmail 앱 비밀번호) =====
EMAIL_USER=                       # (필수)
EMAIL_PASSWORD=                   # (필수)

# ===== swagger — 운영(NODE_ENV=production)에서 /docs 접근 계정 =====
SWAGGER_USER=                     # (운영 필수)
SWAGGER_PASSWORD=                 # (운영 필수)
